# Copy to .env  (never commit .env)
APP_MODE=DEMO
SERIAL_PORT=            # e.g. /dev/ttyUSB0 or COM3 ; empty = auto-detect
SERIAL_BAUD=115200
CAMERA_INDEX=0
YOLO_MODEL_PRIMARY=models/best_ncnn_model
YOLO_MODEL_FALLBACK=models/best.pt
ENABLE_STOP_COMMAND=0   # 1 = write {"cmd":"MOTOR_STOP"} to ESP32 on CRITICAL
ADMIN_PASSWORD=         # protects sidebar controls when dashboard is public
